# Root .env is loaded first; backend/.env overrides when both exist (see backend/server.js).
GEMINI_API_KEY=your_GEMINI_API_KEY_here
COHERE_API_KEY=your_COHERE_API_KEY_here
HUGGINGFACE_API_KEY=your_HUGGINGFACE_API_KEY_here

# Secret for encrypting user-provided Gemini API keys (generate a strong random string)
GEMINI_KEY_ENCRYPTION_SECRET=your_encryption_secret_here

# SMTP credentials for the contact form (required to send contact messages)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Where contact form messages are delivered (defaults to vinithalakhwani002@gmail.com)
CONTACT_TO=vinithalakhwani002@gmail.com

FIREBASE_API_KEY=your_FIREBASE_API_KEY_here
FIREBASE_AUTH_DOMAIN=your_FIREBASE_AUTH_DOMAIN_here
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

PORT=3000
