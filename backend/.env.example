# Backend-specific environment variables
# These override root .env values when both exist

# Secret for encrypting user-provided Gemini API keys (generate a strong random string)
# Required for BYOK functionality
GEMINI_KEY_ENCRYPTION_SECRET=your_encryption_secret_here

# SMTP credentials for the contact form (required to send contact messages).
# Example for Gmail: create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Where contact form messages are delivered (defaults to vinithalakhwani002@gmail.com)
CONTACT_TO=vinithalakhwani002@gmail.com
# Optional custom From address; defaults to SMTP_USER when unset
CONTACT_FROM=